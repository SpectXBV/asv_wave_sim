
<?xml version='1.0'?>
<model>
  <name>Waves JONSWAP</name>
  <version>1.0</version>
  <sdf version='1.6'>model.sdf</sdf>

  <author>
    <name>AquaFind</name>
  </author>

  <description>
    Surface waves generated from a JONSWAP spectrum, parameterised directly
    by significant wave height (Hs), peak period (Tp), peak-enhancement
    factor (gamma) and a dominant wave direction independent of wind.
    A standalone sibling of the 'waves' model (which uses the ECKV
    spectrum driven by wind speed) - see the 'jonswap_fft' algorithm.
  </description>
</model>
