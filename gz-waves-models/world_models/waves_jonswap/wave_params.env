# Single source of truth for the waves_jonswap model's wave parameters.
#
# Edit values here, then regenerate model.sdf:
#   ./generate_model_sdf.sh
#
# generate_model_sdf.sh fills these into BOTH the WavesModel (physics) and
# WavesVisual (rendering) <wave> blocks in model.sdf.template, so they can
# never drift apart - this file is the only place you need to touch.

WAVE_ALGORITHM=jonswap_fft
WAVE_TILE_SIZE=128
WAVE_CELL_COUNT=64
WAVE_HS=22.0
WAVE_TP=16.0
WAVE_GAMMA=3.3
WAVE_DIRECTION_DEG=270
WAVE_DIRECTION_SPREAD=5.0
WAVE_STEEPNESS=2
