# Single source of truth for the waves_jonswap model's wave parameters.
#
# Edit values here, then regenerate model.sdf:
#   ./generate_model_sdf.sh
#
# generate_model_sdf.sh fills these into BOTH the WavesModel (physics) and
# WavesVisual (rendering) <wave> blocks in model.sdf.template, so they can
# never drift apart - this file is the only place you need to touch.

# Wave generation algorithm -- keep as jonswap_fft.
WAVE_ALGORITHM=jonswap_fft

# Size of the square wave tile [m]. Should be >=5-10x the peak wavelength
# (Lp = g*Tp^2/(2*pi)) or Hs will vary a lot depending on where you sample it.
WAVE_TILE_SIZE=256

# FFT grid resolution per side. Together with WAVE_TILE_SIZE sets the
# spatial resolution dx = WAVE_TILE_SIZE / WAVE_CELL_COUNT.
WAVE_CELL_COUNT=128

# Significant wave height [m].
WAVE_HS=6.0

# Peak wave period [s]. Also sets the peak wavelength -- check
# WAVE_TILE_SIZE is still big enough if you change this.
WAVE_TP=6.0

# JONSWAP peak-enhancement factor. 1.0 = broad/mature sea, ~3.3 = typical
# JONSWAP (narrower peak), higher = narrower/younger sea state.
WAVE_GAMMA=3.3

# Dominant wave direction [deg, counter-clockwise from +x].
WAVE_DIRECTION_DEG=90

# Directional spreading around WAVE_DIRECTION_DEG. Higher = narrower/more
# unidirectional, lower = broader spread.
WAVE_DIRECTION_SPREAD=5.0

# Wave steepness/choppiness. 0 = smooth sine waves, higher = sharper crests,
# flatter troughs. Only affects horizontal wave shape, not Hs/Tp.
WAVE_STEEPNESS=2
